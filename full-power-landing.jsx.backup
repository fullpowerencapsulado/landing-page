        @keyframes particle-float-1 {
          0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.3; }
          25% { transform: translate(20px, -30px) scale(1.5); opacity: 0.8; }
          50% { transform: translate(40px, -60px) scale(2); opacity: 1; }
