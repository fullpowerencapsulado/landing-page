        /* Responsividade */
        @media (max-width: 768px) {
          .particle {
            display: none;
          }
        }

        /* Efeito de Glow ao passar o mouse */
        .group:hover .animate-gradient-x {
          animation-duration: 1.5s;
        }

        /* Parallax suave */
        @media (prefers-reduced-motion: no-preference) {
